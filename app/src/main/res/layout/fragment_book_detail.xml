<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_color"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Bar s strelkoy nazad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_arrow_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Halypa"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:fontFamily="@font/libre_baskerville"
                android:gravity="center"/>

            <View
                android:layout_width="48dp"
                android:layout_height="48dp"/>
        </LinearLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/gray"/>

        <!-- Book Cover -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            app:cardCornerRadius="16dp"
            android:layout_height="400dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginVertical="12dp"
            android:elevation="8dp"
            android:radius="16dp">

            <ImageView
                android:id="@+id/detail_book_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#D1D5DB"/>
        </androidx.cardview.widget.CardView>

        <!-- Book Title -->
        <TextView
            android:id="@+id/detail_book_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ak şäherim Aşgabat"
            android:fontFamily="@font/libre_baskerville"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:gravity="center"
            android:paddingHorizontal="24dp"/>

        <!-- Book Info Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingHorizontal="24dp"
            android:layout_marginTop="16dp">

            <!-- Tom Section (pokazyvaetsya TOLKO esli est' toma) -->
            <LinearLayout
                android:id="@+id/tom_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Jilt:"
                    style="@style/text_gray_14"
                    android:layout_gravity="center_vertical"/>

                <Spinner
                    style="@style/text_white_14"
                    android:id="@+id/tom_spinner"
                    android:layout_width="150dp"
                    android:layout_height="30dp"
                    android:background="@drawable/spinner_background"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>
            </LinearLayout>

            <!-- Language Section -->
            <LinearLayout
                android:id="@+id/language_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Dil:"
                    style="@style/text_gray_14"
                    android:layout_gravity="center_vertical"/>

                <!-- ESLI 1 yazyk - prosto TextView -->
                <TextView
                    android:id="@+id/language_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Türkmen"
                    style="@style/text_white_14"
                    android:visibility="visible"/>

                <!-- ESLI neskolko yazykov - Spinner -->
                <Spinner
                    style="@style/text_white_14"
                    android:id="@+id/language_spinner"
                    android:layout_width="150dp"
                    android:layout_height="30dp"
                    android:background="@drawable/spinner_background"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Author -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Awtor:"
                    style="@style/text_gray_14"/>

                <TextView
                    android:id="@+id/detail_author"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gurbanguly Berdimuhamedow"
                    style="@style/text_white_14"/>
            </LinearLayout>

            <!-- Year -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Ýyl:"
                    style="@style/text_gray_14"/>

                <TextView
                    android:id="@+id/detail_year"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2021"
                    style="@style/text_white_14"/>
            </LinearLayout>

            <!-- Pages -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="Sahypa:"
                    style="@style/text_gray_14"/>

                <TextView
                    android:id="@+id/detail_pages"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="344"
                    style="@style/text_white_14"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Read Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/read_button"
            app:cornerRadius="26dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Oka"
            android:textColor="@color/white"
            android:fontFamily="@font/libre_baskerville"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="@color/read_btn_color"
            android:layout_margin="24dp"/>

    </LinearLayout>
</ScrollView>