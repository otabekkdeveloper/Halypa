<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/app_color"
    android:orientation="vertical">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/libre_baskerville"
        android:gravity="center"
        android:padding="24dp"
        android:text="Synag tamamlandy!"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Процент -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/libre_baskerville"
                android:text="Siziň netijäňiz:"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/percentage_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:fontFamily="@font/libre_baskerville"
                android:text="83%"
                android:textColor="#3B82F6"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/result_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginBottom="24dp"
            android:max="100"
            android:progress="83"
            android:progressTint="#3B82F6" />
    </LinearLayout>

    <!-- Статистика -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_search"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/text_gray_16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dogry jogaplar:" />

            <TextView
                android:id="@+id/correct_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/libre_baskerville"
                android:text="10"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#3A3A3C" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/text_gray_16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ýalňyş jogaplar:" />

            <TextView
                android:id="@+id/wrong_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/libre_baskerville"
                android:text="2"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Кнопка показать ошибки -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_show_mistakes"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:cornerRadius="16dp"
        style="@style/text_white_14"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/item_quote_color"
        android:fontFamily="@font/libre_baskerville"
        android:text="Ýalňyşlary görmek" />

    <!-- Кнопка вернуться -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_back_to_tests"
        android:layout_width="match_parent"
        app:cornerRadius="16dp"
        android:layout_height="60dp"
        style="@style/text_white_14"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/ic_checked"
        android:text="Testlere dolanmak" />

</LinearLayout>