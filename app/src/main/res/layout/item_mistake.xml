<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/app_color"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Номер вопроса -->
    <TextView
        android:id="@+id/question_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sorag 3"
        android:textColor="#3B82F6"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="@font/libre_baskerville"
        android:layout_marginBottom="8dp" />

    <!-- Вопрос -->
    <TextView
        android:id="@+id/question_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="@font/libre_baskerville"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Твой ответ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Siziň jogap:"
        android:textColor="#71717A"
        android:textSize="14sp"
        android:fontFamily="@font/libre_baskerville" />

    <TextView
        android:id="@+id/user_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:fontFamily="@font/libre_baskerville"
        android:background="@drawable/bg_answer_wrong"
        android:padding="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <!-- Правильный ответ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dogry jogap:"
        android:textColor="#71717A"
        android:textSize="14sp"
        android:fontFamily="@font/libre_baskerville" />

    <TextView
        android:id="@+id/correct_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:fontFamily="@font/libre_baskerville"
        android:background="@drawable/bg_answer_correct"
        android:padding="12dp"
        android:layout_marginTop="4dp" />

</LinearLayout>