<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/app_color">

    <!-- Контент item -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="12dp"
        android:layout_marginVertical="6dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/book_cover_small"
            android:layout_width="43dp"
            android:layout_height="59dp"
            android:layout_gravity="center"
            android:background="@color/white"
            android:scaleType="centerCrop"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/book_title_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Türkmenistanyň dermanlyk ösümlikleri"
                style="@style/text_white_14"
                android:textSize="12sp"
                android:maxLines="2"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/book_pages_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="25 / 100 sahypa"
                style="@style/text_gray_14"
                android:textSize="10sp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Pie Chart Progress -->
        <RelativeLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_vertical">

            <!-- Percentage Text -->
            <TextView
                android:id="@+id/progress_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="95%"
                android:textColor="@color/blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/libre_baskerville"
                android:layout_toStartOf="@id/pie_chart"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"/>

            <!-- Custom Pie Chart View -->
            <com.example.arkadagapp.presentation.settings.PieChartView
                android:id="@+id/pie_chart"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>

    </LinearLayout>

    <!-- Divider внизу -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginHorizontal="12dp"
        android:background="@color/gray"/>

</LinearLayout>