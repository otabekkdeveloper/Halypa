<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/result_book_cover"
        android:layout_width="48dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:background="#D1D5DB" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/result_book_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ýagşy niýet - ýarym döwlet"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/libre_baskerville"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/result_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Älem içre at gezer"
            android:textColor="#71717A"
            android:textSize="12sp"
            android:fontFamily="@font/libre_baskerville"
            android:maxLines="1"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/result_snippet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="...lardan gorapdyr. Söweşleriň birinde ol agyr ýaralanypdyr. Munuň şeýledigine Zakaryýa..."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/libre_baskerville"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_arrow_right"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        app:tint="#71717A" />

</LinearLayout>